# ==========================================
# AlgoPulse .gitignore
# Optimized for Vercel (Frontend) & Render (Backend)
# ==========================================

# 1. Environment & Secret Keys (DO NOT COMMIT)
.env
.env.*
*.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# 2. Dependencies & Package Managers
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store

# 3. Production Builds & Deployment Artifacts
dist/
client/dist/
build/
out/
.vercel/
.render/
.next/

# 4. Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
*.log.*

# 5. Local Database & Cache Storage
server/data/*.json
server/data/*.tmp
*.sqlite
*.sqlite3
*.db
*.db-journal
*.mdb
*.ldb
dump.rdb

# 6. OS & Editor Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.user
