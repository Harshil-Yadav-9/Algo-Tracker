# AlgoTracker Server Environment Variables Template
PORT=5000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/algotracker?retryWrites=true&w=majority&appName=algotracker
MONGODB_URI=

# JWT Secret for Session Security
JWT_SECRET=algotracker_super_secure_jwt_secret_key_2026

# Google OAuth Client ID
GOOGLE_CLIENT_ID=

# Superuser Admin Google Email
ADMIN_EMAIL=your_admin_email@gmail.com
